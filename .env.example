# Rewrite-RAG local Android integration configuration
OMNICART_SERVICE_NAME=omnicart-agent
OMNICART_VERSION=2.0.0
OMNICART_HOST=0.0.0.0
OMNICART_PORT=8006

# Qwen Model Gateway
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=qwen3-embedding
QWEN_API_KEY=<your-qwen-api-key>
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Retriever
OMNICART_DEFAULT_TOP_K=10

# 向量检索 (pgvector — 使用 PostgreSQL，无需独立向量库)
OMNICART_USE_PG_VECTOR=true
EMBEDDING_DIMENSION=1024

# Docker-published services, accessed from the Windows host.
# Replace host ports and credentials with the values from your Docker Compose setup.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:<postgres-port>/<database>
REDIS_URL=redis://localhost:<redis-port>/0

# Demo / Mock Mode (set to true when Qwen API is unavailable)
OMNICART_MOCK_MODE=false
OMNICART_DEMO_DATA_DIR=data
